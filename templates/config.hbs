<!-- modules/niks-action-hud/templates/config.hbs -->

<div class="ib-config-wrapper">

    <div class="ib-config-layout">
        <!-- Main Configuration Panel -->
        <div class="section right-panel" style="flex: 1; min-height: 0;">

            <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; border-bottom: 1px solid #444; padding-bottom: 8px;">
                <h3 style="margin: 0; border: none; font-size: 1.5em;"><i class="fas fa-cogs" style="color: #4ecdc4; margin-right: 8px;"></i>{{localize "NIKS_ACTION_HUD.Settings.ConfigMenuName"}}</h3>
                <nav class="sheet-tabs tabs">
                    <a class="item" data-tab="actionmenu"><i class="fas fa-th-large"></i> {{localize "IBHUD.Config.Tabs.ActionMenu"}}</a>
                    <a class="item" data-tab="menu"><i class="fas fa-sitemap"></i> {{localize "IBHUD.Config.Tabs.Menu"}}</a>
                    <a class="item" data-tab="common"><i class="fas fa-sliders-h"></i> {{localize "IBHUD.Config.Tabs.Common"}}</a>
                </nav>
            </div>

            <div class="tab-content {{#if isActionMenuTab}}active{{/if}}" data-tab="actionmenu">
                <fieldset style="border:0; padding:0; margin:0;" {{#unless canEditStyle}}disabled{{/unless}}>

                <!-- 3. 액션 메뉴 설정 (Mixed) -->
                <div class="group-label" style="margin-top:15px;">
                    <i class="fas fa-th-large"></i> {{localize "IBHUD.Config.Style.ActionMenuTitle"}}
                </div>

                {{#if isGM}}
                <div class="form-group" style="margin-bottom: 5px;">
                    <label>{{localize "IBHUD.Config.Style.ActionMenuLabel"}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="enableActionMenu" {{#if enableActionMenu}}checked{{/if}}>
                    </div>
                </div>
                <div class="form-group" style="margin-bottom: 5px;">
                    <label>{{localize "IBHUD.Config.Style.UseTokenImg"}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="actionMenuUseTokenImg" {{#if actionMenuUseTokenImg}}checked{{/if}}>
                    </div>
                </div>
                {{#if (or (eq theme "iron") (eq theme "glass"))}}
                <div class="form-group" style="margin-bottom: 5px;">
                    <label>{{localize "IBHUD.Config.Style.EmphasizeFirstActionButton"}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="actionMenuEmphasizeFirstButton" {{#if actionMenuEmphasizeFirstButton}}checked{{/if}}>
                    </div>
                    <p class="notes" style="font-size: 0.95em; color: #888; margin-top: 2px;">{{localize "IBHUD.Config.Style.EmphasizeFirstActionButtonNote"}}</p>
                </div>
                {{/if}}
                <div class="form-group" style="margin-bottom: 5px;">
                    <label>Close Menu After Use</label>
                    <div class="form-fields">
                        <input type="checkbox" name="closeMenuOnUse" {{#if closeMenuOnUse}}checked{{/if}}>
                    </div>
                    <p class="notes" style="font-size: 0.95em; color: #888; margin-top: 2px;">Automatically close the action menu panel after using an item or spell.</p>
                </div>
                {{#if isDnd5eSystem}}
                <div class="form-group" style="margin-bottom: 5px;">
                    <label>{{localize "IBHUD.Config.Style.Dnd5eGroupActionsByActivation"}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="dnd5eGroupActionsByActivation" {{#if dnd5eGroupActionsByActivation}}checked{{/if}}>
                    </div>
                    <p class="notes" style="font-size: 0.95em; color: #888; margin-top: 2px;">{{localize "IBHUD.Config.Style.Dnd5eGroupActionsByActivationNote"}}</p>
                </div>
                {{/if}}
                <div class="form-group" style="margin-top: 5px;">
                    <label>{{localize "IBHUD.Config.Style.ActionMenuFont"}}</label>
                    <select name="actionMenuFont">
                        {{#each fontList}}
                        <option value="{{this.value}}" {{#if (eq this.value @root.actionMenuFont)}}selected{{/if}} style="font-family: '{{this.value}}';">{{this.label}}</option>
                        {{/each}}
                    </select>
                    <p class="notes" style="font-size: 0.95em; color: #888; margin-top: 2px;">{{localize "IBHUD.Config.Style.ActionMenuFontNote"}}</p>
                </div>
                {{/if}}

                <div class="form-group" style="margin-top: 10px; display: flex; align-items: center; gap: 10px;">
                    <label style="flex: 0 0 140px; font-weight: bold;">{{localize "IBHUD.Config.Style.MenuScale"}}</label>
                    <div style="flex: 1; display: flex; align-items: center; gap: 10px;">
                        <input type="range" name="actionMenuScale" min="0.5" max="2.0" step="0.01" value="{{actionMenuScale}}" style="flex: 1;">
                        <span class="range-val" style="min-width: 45px; font-weight: bold; color: #8ab4e8;">{{actionMenuScale}}x</span>
                    </div>
                </div>

                {{#if (eq theme "image")}}
                <div class="group-label" style="margin-top: 15px; display:flex; justify-content:space-between; align-items:center;">
                    <span><i class="fas fa-images"></i> Action Menu Layers</span>
                    <button type="button" data-action="addAMLayer" data-layer-key="amMenuLayers" style="width:auto; font-size:0.9em; padding:2px 8px; background:#444;">
                        <i class="fas fa-plus"></i> {{localize "IBHUD.Config.Style.AddLayer"}}
                    </button>
                </div>
                <div class="card-bg-layers-list" data-scope="am-menu" style="margin-bottom: 5px; background: #262626; padding: 5px; border-radius: 4px; border: 1px solid #333;">
                    {{#each amMenuLayers}}
                    {{#if this._contentMarker}}
                    <!-- Content Marker -->
                    <div style="background: linear-gradient(90deg, #2a2a3a, #1e1e2e); border: 1px dashed #667; border-radius: 4px; padding: 6px 10px; margin-bottom: 5px; display: flex; align-items: center; gap: 8px; opacity: 0.85; user-select: none;">
                        <i class="fas fa-lock" style="color: #7788aa; font-size: 0.95em;"></i>
                        <span style="color: #99aacc; font-size: 0.95em; font-weight: bold;">&#x1F4CB; Content (z:{{this._contentZ}})</span>
                        <span style="color: #667; font-size: 0.9em; margin-left: auto;">Layers above this cover content</span>
                    </div>
                    {{else}}
                    <div class="card-bg-layer-row" data-index="{{this._realIndex}}" style="background: #333; border: 1px solid #444; border-radius: 4px; padding: 5px; margin-bottom: 5px;">
                        <input type="hidden" name="amMenuLayers.{{this._realIndex}}.id" value="{{this.id}}">
                        
                        <div style="display:grid; grid-template-columns: 50px 1fr 30px auto; gap:5px; align-items:center; margin-bottom:5px;">
                            <input type="number" name="amMenuLayers.{{this._realIndex}}.zIndex" value="{{this.zIndex}}" placeholder="Z" title="Z-Index (Background=0)" style="font-size:0.95em;">
                            <input type="text" name="amMenuLayers.{{this._realIndex}}.src" value="{{this.src}}" placeholder="{{localize 'IBHUD.Config.Style.LayerImagePath'}}" style="font-size:0.95em;">
                            <button type="button" class="file-picker-btn" data-target="amMenuLayers.{{this._realIndex}}.src" style="width:30px; padding:0; background:#444; border:1px solid #555; color:#ccc;">
                                <i class="fas fa-folder-open" style="font-size:0.9em;"></i>
                            </button>
                            <button type="button" data-action="removeAMLayer" data-layer-key="amMenuLayers" data-index="{{this._realIndex}}" class="btn-del" style="width:26px; padding:0;"><i class="fas fa-trash"></i></button>
                        </div>
                        
                        <div style="display:grid; grid-template-columns: repeat(8, 1fr); gap:4px; font-size:0.9em;">
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">W</label>
                                <input type="number" name="amMenuLayers.{{this._realIndex}}.width" value="{{this.width}}" step="1" min="0" placeholder="auto">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">H</label>
                                <input type="number" name="amMenuLayers.{{this._realIndex}}.height" value="{{this.height}}" step="1" min="0" placeholder="auto">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">{{localize "IBHUD.Config.Style.Scale"}}</label>
                                <input type="number" name="amMenuLayers.{{this._realIndex}}.scale" value="{{this.scale}}" step="0.1" min="0.1" placeholder="1.0">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">X</label>
                                <input type="number" name="amMenuLayers.{{this._realIndex}}.x" value="{{this.x}}" placeholder="0">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">Y</label>
                                <input type="number" name="amMenuLayers.{{this._realIndex}}.y" value="{{this.y}}" placeholder="0">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">{{localize "IBHUD.Config.Style.Rotation"}}</label>
                                <input type="number" name="amMenuLayers.{{this._realIndex}}.rotation" value="{{this.rotation}}" placeholder="0">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">{{localize "IBHUD.Config.Style.Opacity"}}</label>
                                <input type="number" name="amMenuLayers.{{this._realIndex}}.opacity" value="{{this.opacity}}" step="0.1" min="0" max="1" placeholder="1.0">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">{{localize "IBHUD.Config.Style.Blend"}}</label>
                                <select name="amMenuLayers.{{this._realIndex}}.blend" style="font-size:0.95em; padding:2px;">
                                    <option value="normal" {{#if (eq this.blend "normal")}}selected{{/if}}>Normal</option>
                                    <option value="multiply" {{#if (eq this.blend "multiply")}}selected{{/if}}>Multiply</option>
                                    <option value="screen" {{#if (eq this.blend "screen")}}selected{{/if}}>Screen</option>
                                    <option value="overlay" {{#if (eq this.blend "overlay")}}selected{{/if}}>Overlay</option>
                                    <option value="darken" {{#if (eq this.blend "darken")}}selected{{/if}}>Darken</option>
                                    <option value="lighten" {{#if (eq this.blend "lighten")}}selected{{/if}}>Lighten</option>
                                    <option value="color-dodge" {{#if (eq this.blend "color-dodge")}}selected{{/if}}>Color Dodge</option>
                                    <option value="color-burn" {{#if (eq this.blend "color-burn")}}selected{{/if}}>Color Burn</option>
                                    <option value="hard-light" {{#if (eq this.blend "hard-light")}}selected{{/if}}>Hard Light</option>
                                    <option value="soft-light" {{#if (eq this.blend "soft-light")}}selected{{/if}}>Soft Light</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                    {{/each}}
                </div>

                <div class="group-label" style="margin-top: 15px; display:flex; justify-content:space-between; align-items:center;">
                    <span><i class="fas fa-images"></i> Sub-Menu Layers</span>
                    <button type="button" data-action="addAMLayer" data-layer-key="amSubMenuLayers" style="width:auto; font-size:0.9em; padding:2px 8px; background:#444;">
                        <i class="fas fa-plus"></i> {{localize "IBHUD.Config.Style.AddLayer"}}
                    </button>
                </div>
                <div class="card-bg-layers-list" data-scope="am-submenu" style="margin-bottom: 5px; background: #262626; padding: 5px; border-radius: 4px; border: 1px solid #333;">
                    {{#each amSubMenuLayers}}
                    {{#if this._contentMarker}}
                    <!-- Content Marker -->
                    <div style="background: linear-gradient(90deg, #2a2a3a, #1e1e2e); border: 1px dashed #667; border-radius: 4px; padding: 6px 10px; margin-bottom: 5px; display: flex; align-items: center; gap: 8px; opacity: 0.85; user-select: none;">
                        <i class="fas fa-lock" style="color: #7788aa; font-size: 0.95em;"></i>
                        <span style="color: #99aacc; font-size: 0.95em; font-weight: bold;">&#x1F4CB; Content (z:{{this._contentZ}})</span>
                        <span style="color: #667; font-size: 0.9em; margin-left: auto;">Layers above this cover content</span>
                    </div>
                    {{else}}
                    <div class="card-bg-layer-row" data-index="{{this._realIndex}}" style="background: #333; border: 1px solid #444; border-radius: 4px; padding: 5px; margin-bottom: 5px;">
                        <input type="hidden" name="amSubMenuLayers.{{this._realIndex}}.id" value="{{this.id}}">
                        
                        <div style="display:grid; grid-template-columns: 50px 1fr 30px auto; gap:5px; align-items:center; margin-bottom:5px;">
                            <input type="number" name="amSubMenuLayers.{{this._realIndex}}.zIndex" value="{{this.zIndex}}" placeholder="Z" title="Z-Index (Background=0)" style="font-size:0.95em;">
                            <input type="text" name="amSubMenuLayers.{{this._realIndex}}.src" value="{{this.src}}" placeholder="{{localize 'IBHUD.Config.Style.LayerImagePath'}}" style="font-size:0.95em;">
                            <button type="button" class="file-picker-btn" data-target="amSubMenuLayers.{{this._realIndex}}.src" style="width:30px; padding:0; background:#444; border:1px solid #555; color:#ccc;">
                                <i class="fas fa-folder-open" style="font-size:0.9em;"></i>
                            </button>
                            <button type="button" data-action="removeAMLayer" data-layer-key="amSubMenuLayers" data-index="{{this._realIndex}}" class="btn-del" style="width:26px; padding:0;"><i class="fas fa-trash"></i></button>
                        </div>
                        
                        <div style="display:grid; grid-template-columns: repeat(8, 1fr); gap:4px; font-size:0.9em;">
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">W</label>
                                <input type="number" name="amSubMenuLayers.{{this._realIndex}}.width" value="{{this.width}}" step="1" min="0" placeholder="auto">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">H</label>
                                <input type="number" name="amSubMenuLayers.{{this._realIndex}}.height" value="{{this.height}}" step="1" min="0" placeholder="auto">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">{{localize "IBHUD.Config.Style.Scale"}}</label>
                                <input type="number" name="amSubMenuLayers.{{this._realIndex}}.scale" value="{{this.scale}}" step="0.1" min="0.1" placeholder="1.0">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">X</label>
                                <input type="number" name="amSubMenuLayers.{{this._realIndex}}.x" value="{{this.x}}" placeholder="0">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">Y</label>
                                <input type="number" name="amSubMenuLayers.{{this._realIndex}}.y" value="{{this.y}}" placeholder="0">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">{{localize "IBHUD.Config.Style.Rotation"}}</label>
                                <input type="number" name="amSubMenuLayers.{{this._realIndex}}.rotation" value="{{this.rotation}}" placeholder="0">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">{{localize "IBHUD.Config.Style.Opacity"}}</label>
                                <input type="number" name="amSubMenuLayers.{{this._realIndex}}.opacity" value="{{this.opacity}}" step="0.1" min="0" max="1" placeholder="1.0">
                            </div>
                            <div style="display:flex; flex-direction:column;">
                                <label style="color:#888; font-size:0.95em;">{{localize "IBHUD.Config.Style.Blend"}}</label>
                                <select name="amSubMenuLayers.{{this._realIndex}}.blend" style="font-size:0.95em; padding:2px;">
                                    <option value="normal" {{#if (eq this.blend "normal")}}selected{{/if}}>Normal</option>
                                    <option value="multiply" {{#if (eq this.blend "multiply")}}selected{{/if}}>Multiply</option>
                                    <option value="screen" {{#if (eq this.blend "screen")}}selected{{/if}}>Screen</option>
                                    <option value="overlay" {{#if (eq this.blend "overlay")}}selected{{/if}}>Overlay</option>
                                    <option value="darken" {{#if (eq this.blend "darken")}}selected{{/if}}>Darken</option>
                                    <option value="lighten" {{#if (eq this.blend "lighten")}}selected{{/if}}>Lighten</option>
                                    <option value="color-dodge" {{#if (eq this.blend "color-dodge")}}selected{{/if}}>Color Dodge</option>
                                    <option value="color-burn" {{#if (eq this.blend "color-burn")}}selected{{/if}}>Color Burn</option>
                                    <option value="hard-light" {{#if (eq this.blend "hard-light")}}selected{{/if}}>Hard Light</option>
                                    <option value="soft-light" {{#if (eq this.blend "soft-light")}}selected{{/if}}>Soft Light</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                    {{/each}}
                </div>

                <div class="group-label" style="margin-top: 15px;"><i class="fas fa-paint-brush"></i> Action Menu Element Images</div>
                <p class="notes" style="font-size: 0.95em; color: #888; margin-bottom: 8px;">Layer-based images for Action Menu UI elements. Each element supports multiple stacked image layers.</p>

                {{#each amElements}}
                <details data-am-element="{{this.id}}" style="margin-bottom: 5px; background: #1e1e1e; border: 1px solid #333; border-radius: 4px;">
                	<summary style="cursor: pointer; padding: 6px 10px; display: flex; justify-content: space-between; align-items: center;">
                		<span style="font-weight: bold; color: #8ab4e8; font-size: 0.95em;"><i class="fas fa-cube"></i> {{this.label}}</span>
                		<span style="font-size: 0.95em; color: #666;">{{this.layers.length}} layers</span>
                	</summary>
                	<div style="padding: 8px;">
                		<!-- Text Color -->
                		<div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px; font-size: 0.95em;">
                			<label style="display:flex; align-items:center; gap:3px; color:#aaa;">Text Color
                				<input type="color" name="{{this.id}}Color" value="{{this.color}}" class="opt-color" {{#unless this.color}}data-inactive="true"{{/unless}} style="width:30px; height:24px; padding:0; border:none; background:none; cursor:pointer;">
                			</label>
                			<div style="margin-left: auto;">
                				<button type="button" data-action="addAMLayer" data-layer-key="{{this.id}}Layers" style="width:auto; font-size:0.9em; padding:2px 8px; background:#444; border:1px solid #555; color:#ccc; border-radius:3px; cursor:pointer;">
                					<i class="fas fa-plus"></i> Add Layer
                				</button>
                			</div>
                		</div>

                		<!-- Text Position -->
                		<div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:4px; margin-bottom:8px; font-size:0.9em;">
                			<div style="display:flex; flex-direction:column;">
                				<label style="color:#888; font-size:0.95em;">Text X</label>
                				<input type="number" name="{{this.id}}TextX" value="{{this.textX}}" placeholder="0" step="1">
                			</div>
                			<div style="display:flex; flex-direction:column;">
                				<label style="color:#888; font-size:0.95em;">Text Y</label>
                				<input type="number" name="{{this.id}}TextY" value="{{this.textY}}" placeholder="0" step="1">
                			</div>
                			<div style="display:flex; flex-direction:column;">
                				<label style="color:#888; font-size:0.95em;">Text Scale</label>
                				<input type="number" name="{{this.id}}TextScale" value="{{this.textScale}}" placeholder="1" step="0.1" min="0.1">
                			</div>
                			<div style="display:flex; flex-direction:column;">
                				<label style="color:#888; font-size:0.95em;">Text Rot</label>
                				<input type="number" name="{{this.id}}TextRotation" value="{{this.textRotation}}" placeholder="0" step="1">
                			</div>
                		</div>

                		<!-- Layers -->
                		<div class="am-element-layers-list" style="background: #262626; padding: 5px; border-radius: 4px; border: 1px solid #333;">

                			{{#each this.layers}}
                			{{#if this._contentMarker}}
                			<!-- Content Marker (locked, non-editable) -->
                			<div style="background: linear-gradient(90deg, #2a2a3a, #1e1e2e); border: 1px dashed #667; border-radius: 4px; padding: 6px 10px; margin-bottom: 5px; display: flex; align-items: center; gap: 8px; opacity: 0.85; user-select: none;">
                				<i class="fas fa-lock" style="color: #7788aa; font-size: 0.95em;"></i>
                				<span style="color: #99aacc; font-size: 0.95em; font-weight: bold;">&#x1F4CB; Content (z:{{this._contentZ}})</span>
                				<span style="color: #667; font-size: 0.9em; margin-left: auto;">Layers above this cover content</span>
                			</div>
                			{{else}}
                			<div class="card-bg-layer-row" data-index="{{this._realIndex}}" style="background: #333; border: 1px solid #444; border-radius: 4px; padding: 5px; margin-bottom: 5px;">
                				<input type="hidden" name="{{../id}}Layers.{{this._realIndex}}.id" value="{{this.id}}">
                				
                				<div style="display:grid; grid-template-columns: 50px 1fr 30px auto; gap:5px; align-items:center; margin-bottom:5px;">
                					<input type="number" name="{{../id}}Layers.{{this._realIndex}}.zIndex" value="{{this.zIndex}}" placeholder="Z" title="Z-Index" style="font-size:0.95em;">
                					<input type="text" name="{{../id}}Layers.{{this._realIndex}}.src" value="{{this.src}}" placeholder="Image path..." style="font-size:0.95em;">
                					<button type="button" class="file-picker-btn" data-target="{{../id}}Layers.{{this._realIndex}}.src" style="width:30px; padding:0; background:#444; border:1px solid #555; color:#ccc;">
                						<i class="fas fa-folder-open" style="font-size:0.9em;"></i>
                					</button>
                					<button type="button" data-action="removeAMLayer" data-layer-key="{{../id}}Layers" data-index="{{this._realIndex}}" class="btn-del" style="width:26px; padding:0;"><i class="fas fa-trash"></i></button>
                				</div>
                				
                				<div style="display:grid; grid-template-columns: repeat(8, 1fr); gap:4px; font-size:0.9em;">
                					<div style="display:flex; flex-direction:column;">
                						<label style="color:#888; font-size:0.95em;">W</label>
                						<input type="number" name="{{../id}}Layers.{{this._realIndex}}.width" value="{{this.width}}" step="1" min="0" placeholder="auto">
                					</div>
                					<div style="display:flex; flex-direction:column;">
                						<label style="color:#888; font-size:0.95em;">H</label>
                						<input type="number" name="{{../id}}Layers.{{this._realIndex}}.height" value="{{this.height}}" step="1" min="0" placeholder="auto">
                					</div>
                					<div style="display:flex; flex-direction:column;">
                						<label style="color:#888; font-size:0.95em;">Scale</label>
                						<input type="number" name="{{../id}}Layers.{{this._realIndex}}.scale" value="{{this.scale}}" step="0.1" min="0.1" placeholder="1.0">
                					</div>
                					<div style="display:flex; flex-direction:column;">
                						<label style="color:#888; font-size:0.95em;">X</label>
                						<input type="number" name="{{../id}}Layers.{{this._realIndex}}.x" value="{{this.x}}" placeholder="0">
                					</div>
                					<div style="display:flex; flex-direction:column;">
                						<label style="color:#888; font-size:0.95em;">Y</label>
                						<input type="number" name="{{../id}}Layers.{{this._realIndex}}.y" value="{{this.y}}" placeholder="0">
                					</div>
                					<div style="display:flex; flex-direction:column;">
                						<label style="color:#888; font-size:0.95em;">Rotation</label>
                						<input type="number" name="{{../id}}Layers.{{this._realIndex}}.rotation" value="{{this.rotation}}" placeholder="0">
                					</div>
                					<div style="display:flex; flex-direction:column;">
                						<label style="color:#888; font-size:0.95em;">Opacity</label>
                						<input type="number" name="{{../id}}Layers.{{this._realIndex}}.opacity" value="{{this.opacity}}" step="0.1" min="0" max="1" placeholder="1.0">
                					</div>
                					<div style="display:flex; flex-direction:column;">
                						<label style="color:#888; font-size:0.95em;">Blend</label>
                						<select name="{{../id}}Layers.{{this._realIndex}}.blend" style="font-size:0.95em; padding:2px;">
                							<option value="normal" {{#if (eq this.blend "normal")}}selected{{/if}}>Normal</option>
                							<option value="multiply" {{#if (eq this.blend "multiply")}}selected{{/if}}>Multiply</option>
                							<option value="screen" {{#if (eq this.blend "screen")}}selected{{/if}}>Screen</option>
                							<option value="overlay" {{#if (eq this.blend "overlay")}}selected{{/if}}>Overlay</option>
                							<option value="darken" {{#if (eq this.blend "darken")}}selected{{/if}}>Darken</option>
                							<option value="lighten" {{#if (eq this.blend "lighten")}}selected{{/if}}>Lighten</option>
                							<option value="color-dodge" {{#if (eq this.blend "color-dodge")}}selected{{/if}}>Color Dodge</option>
                							<option value="color-burn" {{#if (eq this.blend "color-burn")}}selected{{/if}}>Color Burn</option>
                							<option value="hard-light" {{#if (eq this.blend "hard-light")}}selected{{/if}}>Hard Light</option>
                							<option value="soft-light" {{#if (eq this.blend "soft-light")}}selected{{/if}}>Soft Light</option>
                						</select>
                					</div>
                				</div>
                			</div>
                			{{/if}}
                			{{/each}}
                		</div>
                	</div>
                </details>
                {{/each}}
                {{/if}}

                </fieldset>
            </div>

            <div class="tab-content {{#if isMenuTab}}active{{/if}}" data-tab="menu">
                <fieldset style="border:0; padding:0; margin:0;" {{#unless canEditMenu}}disabled{{/unless}}>
                {{#if (not canEditMenu)}}
