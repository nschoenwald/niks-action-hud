                    <i class="fas fa-exclamation-triangle"></i> {{localize "IBHUD.Config.Menu.Locked"}}
                </div>
                {{else}}
                <div class="ib-menu-workflow-note">
                    <i class="fas fa-info-circle"></i>
                    <span>{{localize "IBHUD.Config.Menu.WorkflowNote"}}</span>
                </div>

                <div class="menu-builder-header">
                    <span>{{localize "IBHUD.Config.Menu.Explanation"}}</span>
                    <button type="button" data-action="addCategory" class="btn-add-cat">
                        <i class="fas fa-plus"></i> {{localize "IBHUD.Config.Menu.AddCategory"}}
                    </button>
                </div>

                {{#if isGM}}
                <div class="action-menu-preset-bar">
                    <div class="action-menu-preset-title">
                        <i class="fas fa-layer-group"></i>
                        <span>{{localize "IBHUD.Preset.ActionMenu.Title"}}</span>
                    </div>
                    <select name="actionMenuPresetSelect" aria-label="{{localize 'IBHUD.Preset.ActionMenu.Title'}}">
                        <option value="">{{localize "IBHUD.Preset.ActionMenu.Select"}}</option>
                        {{#each actionMenuPresets as |presetName|}}
                        <option value="{{presetName}}">{{presetName}}</option>
                        {{/each}}
                    </select>
                    <button type="button" data-action="saveActionMenuPreset">
                        <i class="fas fa-save"></i> {{localize "IBHUD.Preset.ActionMenu.Save"}}
                    </button>
                    <button type="button" data-action="loadActionMenuPreset" {{#unless actionMenuPresets.length}}disabled{{/unless}}>
                        <i class="fas fa-upload"></i> {{localize "IBHUD.Preset.ActionMenu.Load"}}
                    </button>
                    <button type="button" data-action="deleteActionMenuPreset" class="danger" {{#unless actionMenuPresets.length}}disabled{{/unless}}>
                        <i class="fas fa-trash"></i> {{localize "IBHUD.Preset.ActionMenu.Delete"}}
                    </button>
                    <span class="action-menu-preset-hint">{{localize "IBHUD.Preset.ActionMenu.Hint"}}</span>
                </div>
                {{/if}}

                {{#if hasExternalAdapterMenu}}
                <div class="adapter-menu-preview-toolbar">
                    <div class="adapter-menu-preview-heading">
                        <i class="fas fa-plug"></i>
                        <strong>{{localize "IBHUD.Config.Menu.AdapterPreviewTitle"}}</strong>
                    </div>
                    {{#if menuPreviewActors.length}}
                    <label>
                        <span>{{localize "IBHUD.Config.Menu.AdapterPreviewActor"}}</span>
                        <select class="adapter-menu-preview-actor">
                            {{#each menuPreviewActors as |actor|}}
                            <option value="{{actor.id}}" {{#if actor.selected}}selected{{/if}}>{{actor.name}}</option>
                            {{/each}}
                        </select>
                    </label>
                    {{/if}}
                    <span class="adapter-menu-preview-hint">{{localize "IBHUD.Config.Menu.AdapterPreviewHint"}}</span>
                    {{#unless adapterMenuPreviewAvailable}}
                    <span class="adapter-menu-preview-empty">{{localize "IBHUD.Config.Menu.AdapterPreviewUnavailable"}}</span>
                    {{/unless}}
                </div>
                {{/if}}

                <details class="ib-menu-live-preview" aria-label="{{localize 'IBHUD.Config.Menu.LivePreviewTitle'}}">
                    <summary class="ib-menu-live-preview-header">
                        <span><i class="fas fa-eye"></i> {{localize "IBHUD.Config.Menu.LivePreviewTitle"}}</span>
                        <small>{{localize "IBHUD.Config.Menu.LivePreviewHint"}}</small>
                        <i class="fas fa-chevron-right ib-menu-live-preview-chevron"></i>
                    </summary>
                    <div class="ib-menu-live-preview-stage">
                        <div class="ib-menu-live-buttons"></div>
                    </div>
                </details>

                {{#*inline "adapterCategoryEditor"}}
                <div class="ib-menu-category ib-menu-adapter-category ib-menu-adapter-editor{{#if _collapsed}} is-collapsed{{/if}}" data-adapter-id="{{_adapterId}}">
                    <div class="category-header">
                        <div class="adapter-source-mark">
                            <i class="fas fa-plug"></i>
                        </div>

                        <div class="icon-picker" title="Inner Icon">
                            <i class="{{icon}}"></i>
                            <input type="text" name="adapterMenu.{{_adapterIndex}}.icon" value="{{icon}}" placeholder="Icon">
                        </div>

                        <div class="img-picker" title="Inner Image">
                            <div class="img-preview">
                                {{#if img}}<img src="{{img}}">{{else}}<i class="fas fa-image"></i>{{/if}}
                            </div>
                            <button type="button" class="file-picker-btn small-btn" data-target="adapterMenu.{{_adapterIndex}}.img">
                                <i class="fas fa-folder-open"></i>
                            </button>
                            <input type="text" name="adapterMenu.{{_adapterIndex}}.img" value="{{img}}" placeholder="Icon Img" class="img-path-input">
                        </div>

                        <input type="text" name="adapterMenu.{{_adapterIndex}}.label" value="{{label}}" placeholder="Category Name" class="cat-name">
                        <input type="hidden" name="adapterMenu.{{_adapterIndex}}.id" value="{{_adapterId}}">

                        <span class="adapter-category-meta">
                            <span class="adapter-category-id">{{_adapterId}}</span>
                            <span class="adapter-category-badge">{{localize "IBHUD.Config.Menu.AdapterCategorySource"}}</span>
                        </span>
                        <button type="button" class="category-collapse-toggle" aria-expanded="{{#if _collapsed}}false{{else}}true{{/if}}" title="{{localize 'IBHUD.Config.Menu.CollapseCategory'}}">
                            <i class="fas {{#if _collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
                        </button>
                    </div>

                    <div class="category-editor-body">

                    <div class="category-button-row">
                        <span class="adapter-style-label">Button Style:</span>
                        <div class="img-picker" title="Button Background Image" style="width: 200px;">
                            <div class="img-preview adapter-button-preview">
                                {{#if buttonImg}}<img src="{{buttonImg}}">{{else}}<i class="fas fa-image"></i>{{/if}}
                            </div>
                            <button type="button" class="file-picker-btn small-btn" data-target="adapterMenu.{{_adapterIndex}}.buttonImg">
                                <i class="fas fa-folder-open"></i>
                            </button>
                            <input type="text" name="adapterMenu.{{_adapterIndex}}.buttonImg" value="{{buttonImg}}" placeholder="Background Image Path..." class="img-path-input">
                        </div>
                        <div class="adjust-group">
                            <label>Sc:</label>
                            <input type="number" name="adapterMenu.{{_adapterIndex}}.buttonScale" value="{{buttonScale}}" step="0.1" title="Scale">
                            <label>X:</label>
                            <input type="number" name="adapterMenu.{{_adapterIndex}}.buttonX" value="{{buttonX}}" title="Offset X">
                            <label>Y:</label>
                            <input type="number" name="adapterMenu.{{_adapterIndex}}.buttonY" value="{{buttonY}}" title="Offset Y">
                        </div>
                    </div>

                    <details class="category-feedback-details">
                        <summary><i class="fas fa-font"></i> {{localize "IBHUD.Config.Menu.CategoryPresentation"}}</summary>
                        <div class="category-feedback-grid">
                            <label class="category-font-field">
                                <span>{{localize "IBHUD.Config.Menu.CategoryFont"}}</span>
                                <select name="adapterMenu.{{_adapterIndex}}.fontFamily">
                                    {{#each @root.fontList as |font|}}
                                    <option value="{{font.value}}" {{#if (eq font.value ../fontFamily)}}selected{{/if}} style="font-family:'{{font.value}}';">{{font.label}}</option>
                                    {{/each}}
                                </select>
                            </label>
                            <label class="category-color-field">
                                <span>{{localize "IBHUD.Config.Menu.CategoryTextColor"}}</span>
                                <input type="color" name="adapterMenu.{{_adapterIndex}}.textColor" value="{{textColor}}" class="opt-color" {{#unless textColor}}data-inactive="true"{{/unless}} title="{{localize 'IBHUD.Config.Menu.OptionalColorHint'}}">
                            </label>
                        </div>
                    </details>

                    <details class="btn-frame-details" data-frame-key="adapter:{{_adapterId}}">
                        <summary>
                            <span><i class="fas fa-layer-group"></i> Per-Button Frame</span>
                            <span class="adapter-frame-count">{{_buttonFrameLayers.length}} layers</span>
                        </summary>
                        <div class="adapter-frame-body">
                            <div class="adapter-frame-toolbar">
                                <label>Color
                                    <input type="color" name="adapterMenu.{{_adapterIndex}}.btnFrameColor" value="{{buttonFrameColor}}" class="opt-color" {{#unless buttonFrameColor}}data-inactive="true"{{/unless}}>
                                </label>
                                <span>Empty = use global Button Frame</span>
                                <button type="button" data-action="addBtnFrameLayer" data-adapter-id="{{_adapterId}}">
                                    <i class="fas fa-plus"></i> Add Layer
                                </button>
                            </div>

                            <div class="adapter-frame-layers">
                                {{#each _buttonFrameLayers}}
                                {{#if this._contentMarker}}
                                <div class="adapter-frame-content-marker">
                                    <i class="fas fa-layer-group"></i>
                                    <span>&#x1F4CB; Content (z:{{this._contentZ}})</span>
                                </div>
                                {{else}}
                                <div class="card-bg-layer-row" data-index="{{this._realIndex}}">
                                    <input type="hidden" name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.id" value="{{this.id}}">
                                    <div class="adapter-frame-main-row">
                                        <input type="number" name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.zIndex" value="{{this.zIndex}}" placeholder="Z" title="Z-Index">
                                        <input type="text" name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.src" value="{{this.src}}" placeholder="Image path...">
                                        <button type="button" class="file-picker-btn" data-target="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.src">
                                            <i class="fas fa-folder-open"></i>
                                        </button>
                                        <button type="button" data-action="removeBtnFrameLayer" data-adapter-id="{{../_adapterId}}" data-index="{{this._realIndex}}" class="btn-del"><i class="fas fa-trash"></i></button>
                                    </div>
                                    <div class="adapter-frame-properties">
                                        <label>W<input type="number" name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.width" value="{{this.width}}" step="1" min="0" placeholder="auto"></label>
                                        <label>H<input type="number" name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.height" value="{{this.height}}" step="1" min="0" placeholder="auto"></label>
                                        <label>Scale<input type="number" name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.scale" value="{{this.scale}}" step="0.1" min="0.1" placeholder="1.0"></label>
                                        <label>X<input type="number" name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.x" value="{{this.x}}" placeholder="0"></label>
                                        <label>Y<input type="number" name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.y" value="{{this.y}}" placeholder="0"></label>
                                        <label>Rot<input type="number" name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.rotation" value="{{this.rotation}}" placeholder="0"></label>
                                        <label>Opac<input type="number" name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.opacity" value="{{this.opacity}}" step="0.1" min="0" max="1" placeholder="1.0"></label>
                                        <label>Blend
                                            <select name="adapterMenu.{{../_adapterIndex}}.btnFrame.{{this._realIndex}}.blend">
                                                <option value="normal" {{#if (eq this.blend "normal")}}selected{{/if}}>Normal</option>
                                                <option value="multiply" {{#if (eq this.blend "multiply")}}selected{{/if}}>Multiply</option>
                                                <option value="screen" {{#if (eq this.blend "screen")}}selected{{/if}}>Screen</option>
                                                <option value="overlay" {{#if (eq this.blend "overlay")}}selected{{/if}}>Overlay</option>
                                                <option value="darken" {{#if (eq this.blend "darken")}}selected{{/if}}>Darken</option>
                                                <option value="lighten" {{#if (eq this.blend "lighten")}}selected{{/if}}>Lighten</option>
                                                <option value="color-dodge" {{#if (eq this.blend "color-dodge")}}selected{{/if}}>Color Dodge</option>
                                                <option value="color-burn" {{#if (eq this.blend "color-burn")}}selected{{/if}}>Color Burn</option>
                                                <option value="hard-light" {{#if (eq this.blend "hard-light")}}selected{{/if}}>Hard Light</option>
                                                <option value="soft-light" {{#if (eq this.blend "soft-light")}}selected{{/if}}>Soft Light</option>
                                            </select>
                                        </label>
                                    </div>
                                </div>
                                {{/if}}
                                {{/each}}
                            </div>
                        </div>
                    </details>

                    <div class="adapter-combat-visibility">
                        <label><i class="fas fa-clock"></i> {{localize "IBHUD.Config.Menu.TabVisibility"}}</label>
                        <select name="adapterMenu.{{_adapterIndex}}.tabVisibility">
                            <option value="always" {{#if (eq tabVisibility "always")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.TabVisAlways"}}</option>
                            <option value="combatOnly" {{#if (eq tabVisibility "combatOnly")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.TabVisCombat"}}</option>
                            <option value="hideInCombat" {{#if (eq tabVisibility "hideInCombat")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.TabVisHideCombat"}}</option>
                            <option value="never" {{#if (eq tabVisibility "never")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.TabVisNever"}}</option>
                        </select>
                    </div>
                    <div class="category-visibility-row">
                        <div class="vis-mode-group">
                            <label><i class="fas fa-eye"></i> {{localize "IBHUD.Config.Menu.Visibility.Label"}}</label>
                            <select name="adapterMenu.{{_adapterIndex}}.visibility.mode">
                                <option value="all" {{#if (eq visibility.mode "all")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.Visibility.All"}}</option>
                                <option value="only" {{#if (eq visibility.mode "only")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.Visibility.Only"}}</option>
                                <option value="except" {{#if (eq visibility.mode "except")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.Visibility.Except"}}</option>
                            </select>
                        </div>

                        {{#if (or (eq visibility.mode "only") (eq visibility.mode "except"))}}
                        <div class="vis-filters">
                            <div class="vis-type-group">
                                <span class="vis-filter-label">{{localize "IBHUD.Config.Menu.Visibility.ActorTypes"}}:</span>
                                <div class="vis-type-checks">
                                    {{#each visibility._allActorTypes as |aType|}}
                                    <label class="vis-type-chip">
                                        <input type="checkbox" name="adapterMenu.{{../_adapterIndex}}.visibility.actorTypes.{{aType.value}}" {{#if aType.checked}}checked{{/if}}>
                                        {{aType.label}}
                                    </label>
                                    {{/each}}
                                </div>
                            </div>
                            <div class="vis-actor-group">
                                <span class="vis-filter-label">{{localize "IBHUD.Config.Menu.Visibility.Actors"}}:</span>
                                <div class="vis-actor-tags">
                                    {{#each visibility._resolvedActors as |ra|}}
                                    <span class="vis-actor-tag">
                                        {{ra.name}}
                                        <i class="fas fa-times vis-actor-remove" data-adapter-id="{{../_adapterId}}" data-actor-id="{{ra.id}}"></i>
                                    </span>
                                    {{/each}}
                                </div>
                                <div class="vis-actor-add">
                                    <select class="vis-actor-select" data-adapter-id="{{_adapterId}}">
                                        <option value="">{{localize "IBHUD.Config.Menu.Visibility.SelectActor"}}</option>
                                        {{#each visibility._menuActors as |ma|}}
                                        <option value="{{ma.id}}">{{ma.name}} ({{ma.type}})</option>
                                        {{/each}}
                                    </select>
                                </div>
                                <input type="hidden" name="adapterMenu.{{_adapterIndex}}.visibility.actorIds" value="{{join visibility.actorIds ","}}">
                            </div>
                        </div>
                        {{/if}}
                    </div>
                    </div>
                </div>
                {{/inline}}

                <div class="ib-menu-tree">
                    {{#each customMenu as |cat cIdx|}}
                    {{#each cat._adapterRowsBefore as |adapter|}}
                    {{> adapterCategoryEditor adapter}}
                    {{/each}}
                    <div class="ib-menu-category{{#if cat.systemId}} ib-menu-system-category{{/if}}{{#if cat._collapsed}} is-collapsed{{/if}}" data-index="{{cIdx}}">

                        <!-- [1] 윗줄: 기본 정보 -->
                        <div class="category-header">
                            <div class="drag-handle"><i class="fas fa-grip-lines"></i></div>

                            <!-- 아이콘 (내용물) -->
                            <div class="icon-picker" title="Inner Icon">
                                <i class="{{cat.icon}}"></i>
                                <input type="text" name="menu.{{cIdx}}.icon" value="{{cat.icon}}" placeholder="Icon">
                            </div>

                            <!-- 내부 이미지 (내용물) -->
                            <div class="img-picker" title="Inner Image">
                                <div class="img-preview">
                                    {{#if cat.img}}<img src="{{cat.img}}">{{else}}<i class="fas fa-image"></i>{{/if}}
                                </div>
                                <button type="button" class="file-picker-btn small-btn" data-target="menu.{{cIdx}}.img">
                                    <i class="fas fa-folder-open"></i>
                                </button>
                                <input type="text" name="menu.{{cIdx}}.img" value="{{cat.img}}" placeholder="Icon Img"
                                    class="img-path-input">
                            </div>

                            <!-- 이름 입력 -->
                            <input type="text" name="menu.{{cIdx}}.label" value="{{cat.label}}"
                                placeholder="Category Name" class="cat-name">

                            <!-- 시스템 ID (숨김) -->
                            <input type="hidden" name="menu.{{cIdx}}.systemId" value="{{cat.systemId}}">

                            <!-- 사이드바 체크 -->
                            <label class="sidebar-chk">
                                <input type="checkbox" name="menu.{{cIdx}}.useSidebar" {{#if
                                    cat.useSidebar}}checked{{/if}}>
                                Sidebar
                            </label>

                            <button type="button" class="category-collapse-toggle" aria-expanded="{{#if cat._collapsed}}false{{else}}true{{/if}}" title="{{localize 'IBHUD.Config.Menu.CollapseCategory'}}">
                                <i class="fas {{#if cat._collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i>
                            </button>

                            <button type="button" class="btn-del" data-action="removeCategory" data-index="{{cIdx}}"><i
                                    class="fas fa-trash"></i></button>
                        </div>

                        <div class="category-editor-body">

                        <!-- ★ [2] 아랫줄: 버튼 배경 설정 (새로 분리됨) -->
                        <div class="category-button-row">
                            <span style="font-size: 0.9em; color: #888; margin-right: 5px;">Button Style:</span>

                            <!-- 버튼 배경 이미지 -->
                            <div class="img-picker" title="Button Background Image" style="width: 200px;">
                                <div class="img-preview" style="border-color: #e61c34;">
                                    {{#if cat.buttonImg}}<img src="{{cat.buttonImg}}">{{else}}<i
                                        class="fas fa-image"></i>{{/if}}
                                </div>
                                <button type="button" class="file-picker-btn small-btn"
                                    data-target="menu.{{cIdx}}.buttonImg">
                                    <i class="fas fa-folder-open"></i>
                                </button>
                                <input type="text" name="menu.{{cIdx}}.buttonImg" value="{{cat.buttonImg}}"
                                    placeholder="Background Image Path..." class="img-path-input">
                            </div>

                            <!-- 이미지 조정 (S, X, Y) -->
                            <div class="adjust-group">
                                <label>Sc:</label>
                                <input type="number" name="menu.{{cIdx}}.buttonScale" value="{{cat.buttonScale}}"
                                    step="0.1" title="Scale">

                                <label>X:</label>
                                <input type="number" name="menu.{{cIdx}}.buttonX" value="{{cat.buttonX}}"
                                    title="Offset X">

                                <label>Y:</label>
                                <input type="number" name="menu.{{cIdx}}.buttonY" value="{{cat.buttonY}}"
                                    title="Offset Y">
                            </div>
                        </div>

                        <!-- ★ [2.5] Per-Button Frame Layers -->
                        <details class="category-feedback-details">
                            <summary><i class="fas fa-font"></i> {{localize "IBHUD.Config.Menu.CategoryPresentation"}}</summary>
                            <div class="category-feedback-grid">
                                <label class="category-font-field">
                                    <span>{{localize "IBHUD.Config.Menu.CategoryFont"}}</span>
                                    <select name="menu.{{cIdx}}.fontFamily">
                                        {{#each @root.fontList as |font|}}
                                        <option value="{{font.value}}" {{#if (eq font.value ../fontFamily)}}selected{{/if}} style="font-family:'{{font.value}}';">{{font.label}}</option>
                                        {{/each}}
                                    </select>
                                </label>
                                <label class="category-color-field">
                                    <span>{{localize "IBHUD.Config.Menu.CategoryTextColor"}}</span>
                                    <input type="color" name="menu.{{cIdx}}.textColor" value="{{cat.textColor}}" class="opt-color" {{#unless cat.textColor}}data-inactive="true"{{/unless}} title="{{localize 'IBHUD.Config.Menu.OptionalColorHint'}}">
                                </label>
                            </div>
                        </details>

                        <details class="btn-frame-details" data-cindex="{{cIdx}}" style="margin: 3px 5px; background: #1a1a2e; border: 1px solid #333; border-radius: 4px;">
                        	<summary style="cursor: pointer; padding: 4px 8px; display: flex; justify-content: space-between; align-items: center;">
                        		<span style="font-size: 0.9em; color: #b4a8e8;"><i class="fas fa-layer-group"></i> Per-Button Frame</span>
                        		<span style="font-size: 0.85em; color: #666;">{{cat._buttonFrameLayers.length}} layers</span>
                        	</summary>
                        	<div style="padding: 6px;">
                        		<div style="display: flex; gap: 8px; align-items: center; margin-bottom: 6px; font-size: 0.9em;">
                        			<label style="display:flex; align-items:center; gap:3px; color:#aaa;">Color
                        				<input type="color" name="menu.{{cIdx}}.btnFrameColor" value="{{cat.buttonFrameColor}}" class="opt-color" {{#unless cat.buttonFrameColor}}data-inactive="true"{{/unless}} style="width:26px; height:22px; padding:0; border:none; background:none; cursor:pointer;">
                        			</label>
                        			<span style="color:#666; font-size:0.85em; margin-left:4px;">Empty = use global Button Frame</span>
                        			<div style="margin-left: auto;">
                        				<button type="button" data-action="addBtnFrameLayer" data-cindex="{{cIdx}}" style="width:auto; font-size:0.85em; padding:2px 6px; background:#444; border:1px solid #555; color:#ccc; border-radius:3px; cursor:pointer;">
                        					<i class="fas fa-plus"></i> Add Layer
                        				</button>
                        			</div>
                        		</div>

                        		<div style="background: #222; padding: 4px; border-radius: 4px; border: 1px solid #333;">
                        			{{#each cat._buttonFrameLayers}}
                        			{{#if this._contentMarker}}
                        			<div style="background: linear-gradient(90deg, #2a2a3a, #1e1e2e); border: 1px dashed #667; border-radius: 4px; padding: 4px 8px; margin-bottom: 4px; display: flex; align-items: center; gap: 6px; opacity: 0.85;">
                        				<i class="fas fa-lock" style="color: #7788aa; font-size: 0.85em;"></i>
                        				<span style="color: #99aacc; font-size: 0.85em; font-weight: bold;">&#x1F4CB; Content (z:{{this._contentZ}})</span>
                        			</div>
                        			{{else}}
                        			<div class="card-bg-layer-row" data-index="{{this._realIndex}}" style="background: #333; border: 1px solid #444; border-radius: 4px; padding: 4px; margin-bottom: 4px;">
                        				<input type="hidden" name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.id" value="{{this.id}}">

                        				<div style="display:grid; grid-template-columns: 50px 1fr 30px auto; gap:4px; align-items:center; margin-bottom:4px;">
                        					<input type="number" name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.zIndex" value="{{this.zIndex}}" placeholder="Z" title="Z-Index" style="font-size:0.85em;">
                        					<input type="text" name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.src" value="{{this.src}}" placeholder="Image path..." style="font-size:0.85em;">
                        					<button type="button" class="file-picker-btn" data-target="menu.{{@../index}}.btnFrame.{{this._realIndex}}.src" style="width:26px; padding:0; background:#444; border:1px solid #555; color:#ccc;">
                        						<i class="fas fa-folder-open" style="font-size:0.85em;"></i>
                        					</button>
                        					<button type="button" data-action="removeBtnFrameLayer" data-cindex="{{@../index}}" data-index="{{this._realIndex}}" class="btn-del" style="width:22px; padding:0;"><i class="fas fa-trash"></i></button>
                        				</div>

                        				<div style="display:grid; grid-template-columns: repeat(8, 1fr); gap:3px; font-size:0.85em;">
                        					<div style="display:flex; flex-direction:column;">
                        						<label style="color:#888; font-size:0.85em;">W</label>
                        						<input type="number" name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.width" value="{{this.width}}" step="1" min="0" placeholder="auto">
                        					</div>
                        					<div style="display:flex; flex-direction:column;">
                        						<label style="color:#888; font-size:0.85em;">H</label>
                        						<input type="number" name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.height" value="{{this.height}}" step="1" min="0" placeholder="auto">
                        					</div>
                        					<div style="display:flex; flex-direction:column;">
                        						<label style="color:#888; font-size:0.85em;">Scale</label>
                        						<input type="number" name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.scale" value="{{this.scale}}" step="0.1" min="0.1" placeholder="1.0">
                        					</div>
                        					<div style="display:flex; flex-direction:column;">
                        						<label style="color:#888; font-size:0.85em;">X</label>
                        						<input type="number" name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.x" value="{{this.x}}" placeholder="0">
                        					</div>
                        					<div style="display:flex; flex-direction:column;">
                        						<label style="color:#888; font-size:0.85em;">Y</label>
                        						<input type="number" name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.y" value="{{this.y}}" placeholder="0">
                        					</div>
                        					<div style="display:flex; flex-direction:column;">
                        						<label style="color:#888; font-size:0.85em;">Rot</label>
                        						<input type="number" name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.rotation" value="{{this.rotation}}" placeholder="0">
                        					</div>
                        					<div style="display:flex; flex-direction:column;">
                        						<label style="color:#888; font-size:0.85em;">Opac</label>
                        						<input type="number" name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.opacity" value="{{this.opacity}}" step="0.1" min="0" max="1" placeholder="1.0">
                        					</div>
                        					<div style="display:flex; flex-direction:column;">
                        						<label style="color:#888; font-size:0.85em;">Blend</label>
                        						<select name="menu.{{@../index}}.btnFrame.{{this._realIndex}}.blend" style="font-size:0.85em; padding:1px;">
                        							<option value="normal" {{#if (eq this.blend "normal")}}selected{{/if}}>Normal</option>
                        							<option value="multiply" {{#if (eq this.blend "multiply")}}selected{{/if}}>Multiply</option>
                        							<option value="screen" {{#if (eq this.blend "screen")}}selected{{/if}}>Screen</option>
                        							<option value="overlay" {{#if (eq this.blend "overlay")}}selected{{/if}}>Overlay</option>
                        							<option value="darken" {{#if (eq this.blend "darken")}}selected{{/if}}>Darken</option>
                        							<option value="lighten" {{#if (eq this.blend "lighten")}}selected{{/if}}>Lighten</option>
                        							<option value="color-dodge" {{#if (eq this.blend "color-dodge")}}selected{{/if}}>Color Dodge</option>
                        							<option value="color-burn" {{#if (eq this.blend "color-burn")}}selected{{/if}}>Color Burn</option>
                        							<option value="hard-light" {{#if (eq this.blend "hard-light")}}selected{{/if}}>Hard Light</option>
                        							<option value="soft-light" {{#if (eq this.blend "soft-light")}}selected{{/if}}>Soft Light</option>
                        						</select>
                        					</div>
                        				</div>
                        			</div>
                        			{{/if}}
                        			{{/each}}
                        		</div>
                        	</div>
                        </details>

                        <!-- Visibility -->
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 5px;">
                            <label style="font-size: 0.9em; color: #aaa; white-space: nowrap;"><i class="fas fa-clock"></i> {{localize "IBHUD.Config.Menu.TabVisibility"}}</label>
                            <select name="menu.{{cIdx}}.tabVisibility" style="width: 140px;">
                                <option value="always" {{#if (eq cat.tabVisibility "always")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.TabVisAlways"}}</option>
                                <option value="combatOnly" {{#if (eq cat.tabVisibility "combatOnly")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.TabVisCombat"}}</option>
                                <option value="hideInCombat" {{#if (eq cat.tabVisibility "hideInCombat")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.TabVisHideCombat"}}</option>
                                <option value="never" {{#if (eq cat.tabVisibility "never")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.TabVisNever"}}</option>
                            </select>
                        </div>
                        <div class="category-visibility-row">
                            <div class="vis-mode-group">
                                <label><i class="fas fa-eye"></i> {{localize "IBHUD.Config.Menu.Visibility.Label"}}</label>
                                <select name="menu.{{cIdx}}.visibility.mode">
                                    <option value="all" {{#if (eq cat.visibility.mode "all")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.Visibility.All"}}</option>
                                    <option value="only" {{#if (eq cat.visibility.mode "only")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.Visibility.Only"}}</option>
                                    <option value="except" {{#if (eq cat.visibility.mode "except")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.Visibility.Except"}}</option>
                                </select>
                            </div>

                            {{#if (or (eq cat.visibility.mode "only") (eq cat.visibility.mode "except"))}}
                            <div class="vis-filters">
                                <div class="vis-type-group">
                                    <span class="vis-filter-label">{{localize "IBHUD.Config.Menu.Visibility.ActorTypes"}}:</span>
                                    <div class="vis-type-checks">
                                        {{#each cat.visibility._allActorTypes as |aType|}}
                                        <label class="vis-type-chip">
                                            <input type="checkbox"
                                                name="menu.{{cIdx}}.visibility.actorTypes.{{aType.value}}"
                                                {{#if aType.checked}}checked{{/if}}>
                                            {{aType.label}}
                                        </label>
                                        {{/each}}
                                    </div>
                                </div>

                                <div class="vis-actor-group">
                                    <span class="vis-filter-label">{{localize "IBHUD.Config.Menu.Visibility.Actors"}}:</span>
                                    <div class="vis-actor-tags">
                                        {{#each cat.visibility._resolvedActors as |ra|}}
                                        <span class="vis-actor-tag">
                                            {{ra.name}}
                                            <i class="fas fa-times vis-actor-remove" data-cindex="{{cIdx}}" data-actor-id="{{ra.id}}"></i>
                                        </span>
                                        {{/each}}
                                    </div>
                                    <div class="vis-actor-add">
                                        <select class="vis-actor-select" data-cindex="{{cIdx}}">
                                            <option value="">{{localize "IBHUD.Config.Menu.Visibility.SelectActor"}}</option>
                                            {{#each cat.visibility._menuActors as |ma|}}
                                            <option value="{{ma.id}}">{{ma.name}} ({{ma.type}})</option>
                                            {{/each}}
                                        </select>
                                    </div>
                                    <input type="hidden" name="menu.{{cIdx}}.visibility.actorIds"
                                        value="{{join cat.visibility.actorIds ","}}">
                                </div>
                            </div>
                            {{/if}}
                        </div>

                        <div class="subcategory-list">

                            <!-- ★ [조건 분기] 시스템 메뉴인지 확인 -->
                            {{#if cat.systemId}}
                            <div
                                style="padding: 15px; text-align: center; color: #888; background: rgba(255,255,255,0.05); border-radius: 4px; font-style: italic;">
                                <!-- 아이콘 태그 삭제됨 -->

                                <strong style="color: #4ecdc4;">{{localize
                                    "IBHUD.Config.Menu.SystemContentTitle"}}</strong><br>
                                <span style="font-size: 0.95em;">
                                    {{{localize "IBHUD.Config.Menu.SystemContentDesc"}}}
                                </span>
                            </div>
                            {{else}}
                            <!-- [기존 로직] 순수 커스텀 메뉴일 때만 편집기 노출 -->
                            {{#each cat.tabs as |tab tIdx|}}
                            <div class="subcategory-row" data-cindex="{{@../index}}" data-tindex="{{@index}}">
                                <div class="sub-header" style="display: flex; align-items: center; gap: 5px;">
                                    <span class="tree-line">└</span>

                                    <!-- 메인 라벨 -->
                                    <input type="text" name="menu.{{@../index}}.tabs.{{@index}}.label"
                                        value="{{tab.label}}"
                                        placeholder="{{#if ../useSidebar}}Sidebar Group{{else}}Tab Name{{/if}}"
                                        style="flex: 1; font-weight: bold;">

                                    <!-- 서브 라벨 (사이드바 모드용) -->
                                    {{#if ../useSidebar}}
                                    <span style="color: #666;">-</span>
                                    <input type="text" name="menu.{{@../index}}.tabs.{{@index}}.subLabel"
                                        value="{{tab.subLabel}}" placeholder="Top Tab Name"
                                        style="flex: 1; font-size: 1em; color: #4ecdc4;">
                                    {{/if}}

                                    <button type="button" class="btn-del-sub" data-action="removeSubCategory"
                                        data-cindex="{{@../index}}" data-tindex="{{@index}}"><i
                                            class="fas fa-times"></i></button>
                                </div>
                                <details class="tab-visibility-details" style="padding-left: 25px; margin-top: 2px; font-size: 0.85em;" {{#if (or (eq tab.visibility.mode "only") (eq tab.visibility.mode "except"))}}open{{/if}}>
                                    <summary style="color: #888; cursor: pointer; user-select: none;"><i class="fas fa-eye"></i> {{localize "IBHUD.Config.Menu.Visibility.Label"}}: {{#if (eq tab.visibility.mode "only")}}{{localize "IBHUD.Config.Menu.Visibility.Only"}}{{else if (eq tab.visibility.mode "except")}}{{localize "IBHUD.Config.Menu.Visibility.Except"}}{{else}}{{localize "IBHUD.Config.Menu.Visibility.All"}}{{/if}}</summary>
                                    <div style="display: flex; flex-wrap: wrap; gap: 5px; align-items: center; margin-top: 4px;">
                                        <select name="menu.{{@../index}}.tabs.{{@index}}.visibility.mode" style="width: 90px; height: 22px;">
                                            <option value="all" {{#if (eq tab.visibility.mode "all")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.Visibility.All"}}</option>
                                            <option value="only" {{#if (eq tab.visibility.mode "only")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.Visibility.Only"}}</option>
                                            <option value="except" {{#if (eq tab.visibility.mode "except")}}selected{{/if}}>{{localize "IBHUD.Config.Menu.Visibility.Except"}}</option>
                                        </select>
                                        {{#if (or (eq tab.visibility.mode "only") (eq tab.visibility.mode "except"))}}
                                        <div style="margin-top: 3px;">
                                            <span style="color:#888; font-size:0.9em;">{{localize "IBHUD.Config.Menu.Visibility.ActorTypes"}}:</span>
                                            {{#each tab.visibility._allActorTypes as |aType|}}
                                            <label style="display:inline-flex; align-items:center; gap:2px; color:#aaa; margin-right:6px;">
                                                <input type="checkbox" name="menu.{{@../../index}}.tabs.{{@../index}}.visibility.actorTypes.{{aType.value}}" {{#if aType.checked}}checked{{/if}}>
                                                {{aType.label}}
                                            </label>
                                            {{/each}}
                                        </div>
                                        <div style="margin-top: 3px;">
                                            <span style="color:#888; font-size:0.9em;">{{localize "IBHUD.Config.Menu.Visibility.Actors"}}:</span>
                                            <span class="vis-actor-tags" style="display:inline;">
                                                {{#each tab.visibility._resolvedActors as |ra|}}
                                                <span class="vis-actor-tag">{{ra.name}} <i class="fas fa-times vis-actor-remove" data-cindex="{{@../../index}}" data-tindex="{{@../index}}" data-actor-id="{{ra.id}}" data-tab-vis="true"></i></span>
                                                {{/each}}
                                            </span>
                                            <select class="vis-actor-select" data-cindex="{{@../index}}" data-tindex="{{@index}}" data-tab-vis="true" style="width:auto; height:22px;">
                                                <option value="">{{localize "IBHUD.Config.Menu.Visibility.SelectActor"}}</option>
                                                {{#each tab.visibility._menuActors as |ma|}}
                                                <option value="{{ma.id}}">{{ma.name}} ({{ma.type}})</option>
                                                {{/each}}
                                            </select>
                                            <input type="hidden" name="menu.{{@../index}}.tabs.{{@index}}.visibility.actorIds" value="{{join tab.visibility.actorIds ","}}">
                                        </div>
                                        {{/if}}
                                    </div>
                                </details>

                                <!-- 아이템 드롭존 -->
                                <div class="item-drop-zone" data-cindex="{{@../index}}" data-tindex="{{@index}}">
                                    {{#if (eq tab.items.length 0)}}
                                    <div class="empty-msg">{{localize "IBHUD.Config.Menu.DropHere"}}</div>
                                    {{else}}
                                    {{#each tab.items as |item iIdx|}}
                                    <div class="menu-item-tag">
                                        <img src="{{item.img}}" width="20" height="20">
                                        <span>{{item.name}}</span>
                                        <i class="fas fa-times btn-del-item" data-action="removeItem"
                                            data-cindex="{{@../../index}}" data-tindex="{{@../index}}"
                                            data-iindex="{{@index}}"></i>

                                        <input type="hidden"
                                            name="menu.{{@../../index}}.tabs.{{@../index}}.items.{{@index}}.id"
                                            value="{{item.id}}">
                                        <input type="hidden"
                                            name="menu.{{@../../index}}.tabs.{{@../index}}.items.{{@index}}.name"
                                            value="{{item.name}}">
                                        <input type="hidden"
                                            name="menu.{{@../../index}}.tabs.{{@../index}}.items.{{@index}}.img"
                                            value="{{item.img}}">
                                        <input type="hidden"
                                            name="menu.{{@../../index}}.tabs.{{@../index}}.items.{{@index}}.type"
                                            value="{{item.type}}">
                                    </div>
                                    {{/each}}
                                    {{/if}}
                                </div>
                            </div>
                            {{/each}}

                            <button type="button" data-action="addSubCategory" data-index="{{cIdx}}"
                                class="btn-add-sub">
                                <i class="fas fa-plus"></i> {{localize "IBHUD.Config.Menu.AddTab"}}
                            </button>
                            {{/if}}
                        </div>
                        </div>
                    </div>
                    {{/each}}
                    {{#each adapterMenuTrailingRows as |adapter|}}
                    {{> adapterCategoryEditor adapter}}
                    {{/each}}
                </div>
                {{/if}}
                </fieldset>
            </div>


            <div class="tab-content {{#if isCommonTab}}active{{/if}}" data-tab="common">
                <fieldset style="border:0; padding:0; margin:0;" {{#unless canEditStyle}}disabled{{/unless}}>

                <!-- 0. Configuration Presets (GM Only) -->
                {{#if isGM}}
                <div class="group-label" style="margin-top:15px;"><i class="fas fa-box-archive"></i> {{localize "IBHUD.Preset.Full.Title"}}</div>
                <div style="display: flex; gap: 5px; align-items: center; flex-wrap: wrap;">
                    <select name="configPresetSelect" style="flex: 1; min-width: 150px;">
                        <option value="">— {{localize "IBHUD.Preset.Full.SelectPlaceholder"}} —</option>
                        {{#each configPresets}}
                        <option value="{{this}}">{{this}}</option>
                        {{/each}}
                    </select>
                    <button type="button" data-action="saveConfigPreset" style="white-space:nowrap;"><i class="fas fa-save"></i> {{localize "IBHUD.Preset.Full.Save"}}</button>
                    <button type="button" data-action="loadConfigPreset" style="white-space:nowrap;"><i class="fas fa-upload"></i> {{localize "IBHUD.Preset.Full.Load"}}</button>
                    <button type="button" data-action="deleteConfigPreset" style="white-space:nowrap;"><i class="fas fa-trash"></i></button>
                    <span style="color:#555;">|</span>
                    <button type="button" data-action="exportConfigPresetFile" style="white-space:nowrap;"><i class="fas fa-file-export"></i></button>
                    <button type="button" data-action="importConfigPresetFile" style="white-space:nowrap;"><i class="fas fa-file-import"></i></button>
                </div>
                {{/if}}

                <!-- 1. 테마 설정 (GM Only) -->
                {{#if isGM}}
                <div class="group-label" style="margin-top:15px;">{{localize "IBHUD.Config.Style.ThemeTitle"}}</div>
                <div class="form-group">
                    <label>{{localize "IBHUD.Config.Style.ThemeLabel"}}</label>
                    <select name="theme">
                        {{#each themeList}}
                        <option value="{{this.value}}" {{#if this.isSelected}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                    <p class="notes" style="font-size: 0.9em; color: #888; margin-top: 2px;">{{localize
                        "IBHUD.Config.Style.ThemeNote"}}</p>
                </div>
                <div class="form-group" style="margin-top: 10px;">
                    <label>{{localize "IBHUD.Config.Style.FontHeader"}}</label>
                    <select name="fontFamily">
                        {{#each fontList}}
                        <option value="{{this.value}}" {{#if (eq this.value @root.fontFamily)}}selected{{/if}} style="font-family: '{{this.value}}';">{{this.label}}</option>
                        {{/each}}
                    </select>
                </div>
                <div class="form-group" style="margin-top: 5px;">
                    <label>{{localize "IBHUD.Config.Style.FontBody"}}</label>
                    <select name="fontFamilySub">
                        {{#each fontList}}
                        <option value="{{this.value}}" {{#if (eq this.value @root.fontFamilySub)}}selected{{/if}} style="font-family: '{{this.value}}';">{{this.label}}</option>
                        {{/each}}
                    </select>
                    <p class="notes" style="font-size: 0.95em; color: #888; margin-top: 2px;">{{localize "IBHUD.Config.Style.FontNote"}}</p>
                </div>
                {{/if}}

                <div class="form-group" style="margin-top: 5px;">
                    <label style="font-size: 1em;"><i class="fas fa-th-large"></i> {{localize
                        "IBHUD.Config.Style.ActionMenuVisibility"}}</label>
                    <select name="actionMenuVisibility" style="width: 180px;">
                        <option value="always" {{#if (eq actionMenuVisibility "always" )}}selected{{/if}}>{{localize
                            "IBHUD.Config.Style.VisibilityAlways"}}</option>
                        <option value="combatOnly" {{#if (eq actionMenuVisibility "combatOnly" )}}selected{{/if}}>
                            {{localize "IBHUD.Config.Style.VisibilityCombatOnly"}}</option>
                        <option value="never" {{#if (eq actionMenuVisibility "never" )}}selected{{/if}}>
                            {{localize "IBHUD.Config.Style.VisibilityNever"}}</option>
                    </select>
                </div>


                <!-- Excluded Actor Types (Checkbox List) -->
                <div class="form-group" style="margin-top: 10px; flex-wrap: wrap;">
                    <label style="font-size: 1em; width: 100%; margin-bottom: 5px;"><i class="fas fa-ban"></i>
                        Excluded Actor Types</label>
                    <div
                        style="width: 100%; display: flex; flex-wrap: wrap; gap: 10px; background: #222; padding: 8px; border-radius: 4px; border: 1px solid #444;">
                        {{#each allActorTypes}}
                        <label
                            style="display: flex; align-items: center; gap: 5px; font-size: 0.95em; cursor: pointer; color: #ccc; margin: 0;">
                            <input type="checkbox" name="excludedTypes.{{this.value}}" {{#if
                                this.checked}}checked{{/if}}>
                            {{this.label}}
                        </label>
                        {{/each}}
                    </div>
                    <p class="notes" style="width: 100%; font-size: 0.95em; color: #888; margin-top: 2px;">Select actor
                        types to hide the HUD for.</p>
                </div>


                </fieldset>
            </div>

            <!-- ========================================= -->

        </div>
    </div>

    <!-- Footer Buttons -->
    <div class="sheet-footer">
        {{#if (and isGlobal isGM)}}
        <button type="button" data-action="exportTheme"
            style="background: #444; color: #f0ad4e; width: auto; margin-right: 5px;"
            title="{{localize 'IBHUD.Theme.ExportHint'}}">
            <i class="fas fa-palette"></i> {{localize "IBHUD.Theme.Export"}}
        </button>
        <button type="button" data-action="importTheme"
            style="background: #444; color: #f0ad4e; width: auto; margin-right: 10px;"
            title="{{localize 'IBHUD.Theme.ImportHint'}}">
            <i class="fas fa-palette"></i> {{localize "IBHUD.Theme.Import"}}
        </button>
        <button type="button" data-action="exportPreset"
            style="background: #444; color: #4ecdc4; width: auto; margin-right: 5px;">
            <i class="fas fa-file-export"></i> {{localize "IBHUD.Config.Buttons.ExportPreset"}}
        </button>
        <button type="button" data-action="importPreset"
            style="background: #444; color: #4ecdc4; width: auto; margin-right: 10px;">
            <i class="fas fa-file-import"></i> {{localize "IBHUD.Config.Buttons.ImportPreset"}}
        </button>
        {{/if}}

        <button type="button" data-action="reset"
            style="background: #444; color: #ff6b6b; width: auto; margin-right: 10px;">
            <i class="fas fa-undo"></i> {{localize "IBHUD.Config.Buttons.Reset"}}
        </button>

        <button type="submit" class="btn-save" data-action="save" style="width: auto;">
            <i class="fas fa-save"></i>
            {{#if isGM}}{{localize "IBHUD.Config.Buttons.SaveAll"}}{{else}}{{localize "IBHUD.Config.Buttons.SaveMine"}}{{/if}}
