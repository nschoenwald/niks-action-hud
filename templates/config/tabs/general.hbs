<!-- General & Behavior Tab -->
<div class="hud-tab-pane {{#if isGeneralTab}}active{{/if}}" data-tab="general">

    <!-- Card 1: Interaction & Automation -->
    <div class="hud-card">
        <div class="hud-card-header">
            <div class="hud-card-icon"><i class="fas fa-hand-pointer"></i></div>
            <div class="hud-card-titles">
                <h4>Interaction & Automation</h4>
                <p>Configure how menus and submenus react during active gameplay.</p>
            </div>
        </div>
        <div class="hud-card-body">
            <div class="hud-setting-row">
                <div class="hud-setting-info">
                    <label>Close Menu After Action Use</label>
                    <span class="hud-setting-hint">Automatically dismiss open submenu drawers immediately after rolling an attack, spell, or item.</span>
                </div>
                <div class="hud-setting-control">
                    <label class="hud-switch">
                        <input type="checkbox" class="hud-switch-input" name="closeMenuOnUse" {{#if closeMenuOnUse}}checked{{/if}}>
                        <span class="hud-switch-slider"></span>
                    </label>
                </div>
            </div>

            <div class="hud-setting-row">
                <div class="hud-setting-info">
                    <label>Hide Empty Submenus</label>
                    <span class="hud-setting-hint">Automatically conceal category buttons (like Spells or Attacks) if the controlled token has no matching items.</span>
                </div>
                <div class="hud-setting-control">
                    <label class="hud-switch">
                        <input type="checkbox" class="hud-switch-input" name="hideEmptySubmenus" {{#if hideEmptySubmenus}}checked{{/if}}>
                        <span class="hud-switch-slider"></span>
                    </label>
                </div>
            </div>

            {{#if isDnd5eSystem}}
            <div class="hud-setting-row">
                <div class="hud-setting-info">
                    <label>Group Actions by Activation Type</label>
                    <span class="hud-setting-hint">Sort and section actions into Action, Bonus Action, Reaction, and Legendary Action headers.</span>
                </div>
                <div class="hud-setting-control">
                    <label class="hud-switch">
                        <input type="checkbox" class="hud-switch-input" name="dnd5eGroupActionsByActivation" {{#if dnd5eGroupActionsByActivation}}checked{{/if}}>
                        <span class="hud-switch-slider"></span>
                    </label>
                </div>
            </div>

            <div class="hud-setting-row">
                <div class="hud-setting-info">
                    <label>Show Unprepared Wizard Rituals</label>
                    <span class="hud-setting-hint">Display known but unprepared ritual spells in the Spellbook for wizard characters, allowing them to cast ritual spells from their spellbook.</span>
                </div>
                <div class="hud-setting-control">
                    <label class="hud-switch">
                        <input type="checkbox" class="hud-switch-input" name="dnd5eShowUnpreparedRituals" {{#if dnd5eShowUnpreparedRituals}}checked{{/if}}>
                        <span class="hud-switch-slider"></span>
                    </label>
                </div>
            </div>

            <div class="hud-setting-row">
                <div class="hud-setting-info">
                    <label>Auto-Favorite NPC Actions</label>
                    <span class="hud-setting-hint">Automatically favorite attack, damage, and save activities when an NPC token with no favorites is placed on the canvas.</span>
                </div>
                <div class="hud-setting-control">
                    <label class="hud-switch">
                        <input type="checkbox" class="hud-switch-input" name="dnd5eAutoFavoriteNpcActions" {{#if dnd5eAutoFavoriteNpcActions}}checked{{/if}}>
                        <span class="hud-switch-slider"></span>
                    </label>
                </div>
            </div>

            <div class="hud-setting-row">
                <div class="hud-setting-info">
                    <label>Auto-Favorite Max Features</label>
                    <span class="hud-setting-hint">Maximum number of qualifying items or features (with attack, damage, or save activities) an NPC can have to trigger auto-favoriting.</span>
                </div>
                <div class="hud-setting-control">
                    <input type="number" class="hud-input" name="dnd5eAutoFavoriteNpcMax" value="{{dnd5eAutoFavoriteNpcMax}}" min="1" max="20" step="1" style="width: 70px; text-align: center;">
                </div>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- Card 2: Display Rules & Positioning -->
    <div class="hud-card">
        <div class="hud-card-header">
            <div class="hud-card-icon"><i class="fas fa-eye"></i></div>
            <div class="hud-card-titles">
                <h4>Display Rules & Triggers</h4>
                <p>Choose when the HUD appears and how submenu drawers unfold.</p>
            </div>
        </div>
        <div class="hud-card-body">
            <div class="hud-setting-row">
                <div class="hud-setting-info">
                    <label>Visibility Trigger</label>
                    <span class="hud-setting-hint">When should the Action HUD be shown on the canvas?</span>
                </div>
                <div class="hud-setting-control">
                    <select name="actionMenuVisibility" class="hud-select">
                        <option value="always" {{#if (eq actionMenuVisibility "always")}}selected{{/if}}>Always Visible (Token Selected)</option>
                        <option value="combat" {{#if (eq actionMenuVisibility "combat")}}selected{{/if}}>In Combat Only</option>
                        <option value="hover" {{#if (eq actionMenuVisibility "hover")}}selected{{/if}}>On Token Hover</option>
                    </select>
                </div>
            </div>

            <div class="hud-setting-row">
                <div class="hud-setting-info">
                    <label>Fade when Idle (Interface Fading)</label>
                    <span class="hud-setting-hint">Dim the Action HUD when inactive, respecting core Foundry's Inactive Opacity and Fade Speed settings. Restores full opacity on hover, focus, or when a submenu is open.</span>
                </div>
                <div class="hud-setting-control">
                    <label class="hud-switch">
                        <input type="checkbox" class="hud-switch-input" name="fadeWhenIdle" {{#if fadeWhenIdle}}checked{{/if}}>
                        <span class="hud-switch-slider"></span>
                    </label>
                </div>
            </div>

            <div class="hud-setting-row">
                <div class="hud-setting-info">
                    <label>Submenu Expansion Direction</label>
                    <span class="hud-setting-hint">Side on which secondary submenus and item trays unfold.</span>
                </div>
                <div class="hud-setting-control">
                    <select name="actionMenuSubmenuSide" class="hud-select">
                        <option value="auto" {{#if (eq actionMenuSubmenuSide "auto")}}selected{{/if}}>Automatic (Screen Edge Aware)</option>
                        <option value="left" {{#if (eq actionMenuSubmenuSide "left")}}selected{{/if}}>Force Left</option>
                        <option value="right" {{#if (eq actionMenuSubmenuSide "right")}}selected{{/if}}>Force Right</option>
                    </select>
                </div>
            </div>

            <div class="hud-setting-row">
                <div class="hud-setting-info">
                    <label>Tooltip Anchor Mode</label>
                    <span class="hud-setting-hint">Position item details tooltip adjacent to the button or tracking the mouse cursor.</span>
                </div>
                <div class="hud-setting-control">
                    <select name="tooltipPosition" class="hud-select">
                        <option value="anchor" {{#if (eq tooltipPosition "anchor")}}selected{{/if}}>Anchor to HUD Item</option>
                        <option value="cursor" {{#if (eq tooltipPosition "cursor")}}selected{{/if}}>Follow Cursor</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Excluded Actor Types -->
    <div class="hud-card">
        <div class="hud-card-header">
            <div class="hud-card-icon"><i class="fas fa-filter"></i></div>
            <div class="hud-card-titles">
                <h4>Excluded Actor Types</h4>
                <p>Prevent the Action HUD from appearing when controlling specific document types (e.g. vehicles, loot, group).</p>
            </div>
        </div>
        <div class="hud-card-body">
            <div class="hud-chip-group">
                {{#each allActorTypes}}
                <label class="hud-chip {{#if this.checked}}active{{/if}}">
                    <input type="checkbox" class="hud-chip-input" name="excludedActorTypes.{{this.value}}" {{#if this.checked}}checked{{/if}}>
                    <span><i class="fas {{#if this.checked}}fa-check-circle{{else}}fa-circle{{/if}}"></i> {{this.label}}</span>
                </label>
                {{/each}}
            </div>
        </div>
    </div>

</div>
