<!-- Image Theme Studio Tab -->
<div class="hud-tab-pane {{#if isImageStudioTab}}active{{/if}}" data-tab="imageStudio">

    <div class="hud-tab-intro">
        <div class="hud-intro-content">
            <h4><i class="fas fa-layer-group"></i> Image Theme Multi-Layer Studio</h4>
            <p>Composite custom graphical image layers, button frames, and panel textures for the Image HUD theme.</p>
        </div>
        <div class="hud-intro-actions">
            {{#unless isImageTheme}}
            <span class="hud-badge hud-badge-warning"><i class="fas fa-info-circle"></i> Activate "Custom Image Studio" in Appearance tab to use these textures</span>
            {{/unless}}
        </div>
    </div>

    <!-- Main Menu Background Layers -->
    <div class="hud-card">
        <div class="hud-card-header">
            <div class="hud-card-icon"><i class="fas fa-images"></i></div>
            <div class="hud-card-titles">
                <h4>Main Action Bar Background Layers</h4>
                <p>Background graphic layers rendered behind or above the primary HUD button bar.</p>
            </div>
            <button type="button" class="hud-btn hud-btn-sm" data-action="addAMLayer" data-layer-key="amMenuLayers">
                <i class="fas fa-plus"></i> Add Layer
            </button>
        </div>
        <div class="hud-card-body">
            <div class="hud-layers-stack">
                {{#each amMenuLayers}}
                {{#if this._contentMarker}}
                <div class="hud-layer-marker">
                    <span><i class="fas fa-arrows-alt-v"></i> Main Button Content (z-index: {{this.zIndex}})</span>
                </div>
                {{else}}
                <div class="hud-layer-row" data-index="{{@index}}">
                    <div class="hud-layer-thumb">
                        {{#if this.src}}<img src="{{this.src}}" alt="">{{else}}<i class="fas fa-image"></i>{{/if}}
                    </div>
                    <div class="hud-layer-field hud-layer-src">
                        <div class="hud-input-with-button">
                            <input type="text" name="amMenuLayers.{{@index}}.src" value="{{this.src}}" class="hud-input" placeholder="Image file path">
                            <button type="button" class="hud-btn-browse" data-file-picker="amMenuLayers.{{@index}}.src"><i class="fas fa-folder-open"></i></button>
                        </div>
                    </div>
                    <div class="hud-layer-field">
                        <label>Z-Index</label>
                        <input type="number" name="amMenuLayers.{{@index}}.zIndex" value="{{this.zIndex}}" class="hud-input hud-input-sm">
                    </div>
                    <div class="hud-layer-field">
                        <label>Opacity</label>
                        <input type="number" name="amMenuLayers.{{@index}}.opacity" value="{{this.opacity}}" min="0" max="1" step="0.05" class="hud-input hud-input-sm">
                    </div>
                    <div class="hud-layer-field">
                        <label>Blend</label>
                        <select name="amMenuLayers.{{@index}}.blend" class="hud-select hud-select-sm">
                            {{#each @root.blendModes}}
                            <option value="{{this.value}}" {{#if (eq this.value ../blend)}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <button type="button" class="hud-btn-icon hud-btn-danger" data-action="removeAMLayer" data-layer-key="amMenuLayers" data-index="{{@index}}" title="Remove Layer">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                {{/if}}
                {{/each}}
            </div>
        </div>
    </div>

    <!-- Submenu Panel Background Layers -->
    <div class="hud-card">
        <div class="hud-card-header">
            <div class="hud-card-icon"><i class="fas fa-window-maximize"></i></div>
            <div class="hud-card-titles">
                <h4>Submenu Panel Background Layers</h4>
                <p>Background graphic layers rendered behind the drawer panel when browsing spells or items.</p>
            </div>
            <button type="button" class="hud-btn hud-btn-sm" data-action="addAMLayer" data-layer-key="amSubMenuLayers">
                <i class="fas fa-plus"></i> Add Layer
            </button>
        </div>
        <div class="hud-card-body">
            <div class="hud-layers-stack">
                {{#each amSubMenuLayers}}
                {{#if this._contentMarker}}
                <div class="hud-layer-marker">
                    <span><i class="fas fa-arrows-alt-v"></i> Submenu Content (z-index: {{this.zIndex}})</span>
                </div>
                {{else}}
                <div class="hud-layer-row" data-index="{{@index}}">
                    <div class="hud-layer-thumb">
                        {{#if this.src}}<img src="{{this.src}}" alt="">{{else}}<i class="fas fa-image"></i>{{/if}}
                    </div>
                    <div class="hud-layer-field hud-layer-src">
                        <div class="hud-input-with-button">
                            <input type="text" name="amSubMenuLayers.{{@index}}.src" value="{{this.src}}" class="hud-input" placeholder="Image file path">
                            <button type="button" class="hud-btn-browse" data-file-picker="amSubMenuLayers.{{@index}}.src"><i class="fas fa-folder-open"></i></button>
                        </div>
                    </div>
                    <div class="hud-layer-field">
                        <label>Z-Index</label>
                        <input type="number" name="amSubMenuLayers.{{@index}}.zIndex" value="{{this.zIndex}}" class="hud-input hud-input-sm">
                    </div>
                    <div class="hud-layer-field">
                        <label>Opacity</label>
                        <input type="number" name="amSubMenuLayers.{{@index}}.opacity" value="{{this.opacity}}" min="0" max="1" step="0.05" class="hud-input hud-input-sm">
                    </div>
                    <div class="hud-layer-field">
                        <label>Blend</label>
                        <select name="amSubMenuLayers.{{@index}}.blend" class="hud-select hud-select-sm">
                            {{#each @root.blendModes}}
                            <option value="{{this.value}}" {{#if (eq this.value ../blend)}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <button type="button" class="hud-btn-icon hud-btn-danger" data-action="removeAMLayer" data-layer-key="amSubMenuLayers" data-index="{{@index}}" title="Remove Layer">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                {{/if}}
                {{/each}}
            </div>
        </div>
    </div>

    <!-- Element Layer Compositors -->
    {{#each amElements}}
    <div class="hud-card">
        <div class="hud-card-header">
            <div class="hud-card-icon"><i class="{{this.icon}}"></i></div>
            <div class="hud-card-titles">
                <h4>{{localize this.label}}</h4>
                <p>Configure custom layers and styling for {{localize this.label}}.</p>
            </div>
            <button type="button" class="hud-btn hud-btn-sm" data-action="addAMLayer" data-layer-key="{{this.id}}Layers">
                <i class="fas fa-plus"></i> Add Layer
            </button>
        </div>
        <div class="hud-card-body">
            <div class="hud-sub-settings-grid" style="margin-bottom: 12px;">
                <div class="hud-field-group">
                    <label>Scale</label>
                    <input type="number" name="{{this.id}}Scale" value="{{this.scale}}" step="0.05" class="hud-input hud-input-sm">
                </div>
                <div class="hud-field-group">
                    <label>Offset X (px)</label>
                    <input type="number" name="{{this.id}}X" value="{{this.x}}" class="hud-input hud-input-sm">
                </div>
                <div class="hud-field-group">
                    <label>Offset Y (px)</label>
                    <input type="number" name="{{this.id}}Y" value="{{this.y}}" class="hud-input hud-input-sm">
                </div>
                <div class="hud-field-group">
                    <label>Accent Color</label>
                    <input type="text" name="{{this.id}}Color" value="{{this.color}}" class="hud-input hud-input-sm hud-color-input" placeholder="#ffffff">
                </div>
            </div>

            <div class="hud-layers-stack">
                {{#each this.layers}}
                {{#if this._contentMarker}}
                <div class="hud-layer-marker">
                    <span><i class="fas fa-arrows-alt-v"></i> Element Content (z-index: {{this.zIndex}})</span>
                </div>
                {{else}}
                <div class="hud-layer-row" data-index="{{@index}}">
                    <div class="hud-layer-thumb">
                        {{#if this.src}}<img src="{{this.src}}" alt="">{{else}}<i class="fas fa-image"></i>{{/if}}
                    </div>
                    <div class="hud-layer-field hud-layer-src">
                        <div class="hud-input-with-button">
                            <input type="text" name="{{../id}}Layers.{{@index}}.src" value="{{this.src}}" class="hud-input" placeholder="Image file path">
                            <button type="button" class="hud-btn-browse" data-file-picker="{{../id}}Layers.{{@index}}.src"><i class="fas fa-folder-open"></i></button>
                        </div>
                    </div>
                    <div class="hud-layer-field">
                        <label>Z-Index</label>
                        <input type="number" name="{{../id}}Layers.{{@index}}.zIndex" value="{{this.zIndex}}" class="hud-input hud-input-sm">
                    </div>
                    <div class="hud-layer-field">
                        <label>Opacity</label>
                        <input type="number" name="{{../id}}Layers.{{@index}}.opacity" value="{{this.opacity}}" min="0" max="1" step="0.05" class="hud-input hud-input-sm">
                    </div>
                    <div class="hud-layer-field">
                        <label>Blend</label>
                        <select name="{{../id}}Layers.{{@index}}.blend" class="hud-select hud-select-sm">
                            {{#each @root.blendModes}}
                            <option value="{{this.value}}" {{#if (eq this.value ../blend)}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <button type="button" class="hud-btn-icon hud-btn-danger" data-action="removeAMLayer" data-layer-key="{{../id}}Layers" data-index="{{@index}}" title="Remove Layer">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                {{/if}}
                {{/each}}
            </div>
        </div>
    </div>
    {{/each}}

</div>
