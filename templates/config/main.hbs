<!-- Nik's Action HUD Configuration Application Shell -->
<div class="hud-config-shell">

    <!-- Top Window Header Bar -->
    <header class="hud-top-bar">
        <div class="hud-brand">
            <div class="hud-brand-icon">
                <i class="fas fa-meteor"></i>
            </div>
            <div class="hud-brand-text">
                <h2>Nik's Action HUD</h2>
                <span class="hud-version-tag">v14.1.2</span>
            </div>
        </div>
        <div class="hud-top-status">
            <span class="hud-live-badge"><i class="fas fa-circle"></i> Live Preview Active</span>
        </div>
    </header>

    <!-- Main Two-Tier Body -->
    <div class="hud-main-body">

        <!-- Left Navigation Sidebar Rail -->
        <nav class="hud-sidebar-nav">
            <div class="hud-nav-section-title">CONFIGURATION</div>

            <button type="button" class="hud-nav-item {{#if isGeneralTab}}active{{/if}}" data-tab="general">
                <i class="fas fa-sliders"></i>
                <div class="hud-nav-label">
                    <span>General</span>
                    <small>Behavior & Rules</small>
                </div>
            </button>

            <button type="button" class="hud-nav-item {{#if isAppearanceTab}}active{{/if}}" data-tab="appearance">
                <i class="fas fa-palette"></i>
                <div class="hud-nav-label">
                    <span>Appearance</span>
                    <small>Themes, Scale & Pos</small>
                </div>
            </button>

            <button type="button" class="hud-nav-item {{#if isMenuTab}}active{{/if}}" data-tab="menu">
                <i class="fas fa-sitemap"></i>
                <div class="hud-nav-label">
                    <span>Menu Builder</span>
                    <small>Categories & Submenus</small>
                </div>
            </button>

            <button type="button" class="hud-nav-item {{#if isImageStudioTab}}active{{/if}}" data-tab="imageStudio">
                <i class="fas fa-layer-group"></i>
                <div class="hud-nav-label">
                    <span>Image Studio</span>
                    <small>Layer Compositor</small>
                </div>
                {{#if isImageTheme}}<span class="hud-nav-pill">Active</span>{{/if}}
            </button>

            <button type="button" class="hud-nav-item {{#if isPresetsTab}}active{{/if}}" data-tab="presets">
                <i class="fas fa-bookmark"></i>
                <div class="hud-nav-label">
                    <span>Presets & Backup</span>
                    <small>Export, Import, Reset</small>
                </div>
            </button>
        </nav>

        <!-- Right Scrollable Content Pane -->
        <main class="hud-content-pane">
            {{> "modules/niks-action-hud/templates/config/tabs/general.hbs"}}
            {{> "modules/niks-action-hud/templates/config/tabs/appearance.hbs"}}
            {{> "modules/niks-action-hud/templates/config/tabs/menu-builder.hbs"}}
            {{> "modules/niks-action-hud/templates/config/tabs/image-studio.hbs"}}
            {{> "modules/niks-action-hud/templates/config/tabs/presets.hbs"}}
        </main>

    </div>

    <!-- Bottom Action Footer Bar -->
    <footer class="hud-footer-bar">
        <div class="hud-footer-left">
            <span class="hud-status-hint"><i class="fas fa-keyboard"></i> Press <kbd>Ctrl+S</kbd> to save</span>
        </div>
        <div class="hud-footer-right">
            <button type="button" class="hud-btn hud-btn-outline" data-action="reset" data-scope="all">
                <i class="fas fa-rotate-left"></i> Reset
            </button>
            <button type="button" class="hud-btn hud-btn-primary hud-btn-save" data-action="save">
                <i class="fas fa-check"></i> Save Changes
            </button>
        </div>
    </footer>

</div>
